<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>
            Provides the following JavaScript libraries for Elsa:
            - lodash
            - moment
        </Description>
        <PackageTags>elsa module expressions scripting javascript libraries</PackageTags>
    </PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="D:\repos\elsa-core-main\src\common\Elsa.Features\Elsa.Features.csproj" />
		<ProjectReference Include="D:\repos\elsa-core-main\src\modules\Elsa.Expressions.JavaScript\Elsa.Expressions.JavaScript.csproj" />
	</ItemGroup>

	<ItemGroup>
      <None Remove="ClientLib\dist\*.js" />
      <EmbeddedResource Include="ClientLib\dist\*.js">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="ClientLib\dist\" />
    </ItemGroup>

</Project>
